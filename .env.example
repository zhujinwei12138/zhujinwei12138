# ── Database ─────────────────────────────────────────────────────
# 本地开发直连
DATABASE_URL=postgresql+asyncpg://beer:beer@localhost:5432/beerdb
# Docker Compose 环境下 app 服务使用（由 docker-compose.yml 自动拼接）
DB_USER=beer
DB_PASSWORD=change-db-password-in-production
DB_NAME=beerdb

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Admin Auth ────────────────────────────────────────────────────
# JWT 签名密钥 — 生产环境必须修改
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-this-before-production

# 管理员用户名
ADMIN_USER=admin

# 方式一（推荐）：直接设置 bcrypt 哈希（不暴露明文）
# 生成命令：python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(12)).decode())"
ADMIN_PASS_HASH=

# 方式二（开发用）：明文密码，启动时自动 hash（生产环境请改用上面的 ADMIN_PASS_HASH）
ADMIN_PASS=admin2024

# JWT Token 有效期（小时，默认 8）
ADMIN_TOKEN_TTL_HOURS=8

# ── Payment Gateway ───────────────────────────────────────────────
# 支付回调 HMAC-SHA256 密钥 — 必须设置，否则 /callback/* 返回 500
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=change-this-before-production

# ── CORS ──────────────────────────────────────────────────────────
# 逗号分隔的允许来源，生产环境应填写实际域名，开发可用 *
ALLOWED_ORIGINS=*
