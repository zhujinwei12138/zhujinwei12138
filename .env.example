# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://beer:beer@localhost:5432/beerdb
DB_USER=beer
DB_PASSWORD=change-db-password-in-production
DB_NAME=beerdb

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# 生产环境必须设置 Redis 密码（docker-compose 会自动拼入 REDIS_URL）
# 生成命令：python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=change-redis-password-in-production

# ── Admin Auth ────────────────────────────────────────────────────
# JWT 签名密钥 — 生产环境必须修改
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-this-before-production

ADMIN_USER=admin

# 方式一（推荐）：bcrypt 哈希
# 生成命令：python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(12)).decode())"
ADMIN_PASS_HASH=

# 方式二（开发用）：明文密码，首次启动自动 hash
ADMIN_PASS=admin2024

ADMIN_TOKEN_TTL_HOURS=8

# ── Payment Gateway ───────────────────────────────────────────────
# 支付回调签名密钥 — 必须设置，否则 /callback/* 返回 500
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=change-this-before-production

# 支付模式: mock（演示，mock-pay 端点开放）| live（真实网关，mock-pay 返回 404）
PAYMENT_MODE=mock

# WeChat Pay v3（PAYMENT_MODE=live 时必填）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/app/certs/wechat_private_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/payments/callback/wechat

# Alipay（PAYMENT_MODE=live 时必填）
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/callback/alipay

# ── Customer OTP ─────────────────────────────────────────────────
# 演示模式：send-otp 接口在响应中返回明文验证码（方便调试，生产必须设 false）
DEMO_MODE=false

# ── CORS ──────────────────────────────────────────────────────────
# 逗号分隔的允许来源，生产填写实际域名
ALLOWED_ORIGINS=*
