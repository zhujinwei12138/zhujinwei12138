# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://beer:beer@localhost:5432/beerdb

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Admin Auth ───────────────────────────────────────────────────
# MUST be changed in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-this-before-production

# Admin login credentials (change before deploying)
ADMIN_USER=admin
ADMIN_PASS=admin2024

# JWT token expiry in hours (default: 8)
ADMIN_TOKEN_TTL_HOURS=8

# ── Payment Gateway ──────────────────────────────────────────────
# Webhook HMAC-SHA256 secret — MUST be set or /callback/* will return 500
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=change-this-before-production

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all (dev only)
ALLOWED_ORIGINS=*
