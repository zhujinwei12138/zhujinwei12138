<!-- pages/orders/index.wxml -->
<view class="page">

  <!-- Tabs -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id"
      class="tab-item {{activeTab === item.id ? 'tab-active' : ''}}"
      bindtap="onTabChange" data-tab="{{item.id}}">
      <text class="tab-text">{{item.label}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === item.id}}"></view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-center">
    <text>加载中…</text>
  </view>

  <!-- Orders list -->
  <view wx:elif="{{filteredOrders.length === 0}}" class="empty-state">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无订单</text>
    <navigator url="/pages/index/index" open-type="reLaunch" class="go-order-btn">
      去点单
    </navigator>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{filteredOrders}}" wx:key="id" class="order-card card">
      <!-- Header -->
      <view class="order-header">
        <view class="order-meta">
          <text class="order-id">#{{item.id}}</text>
          <text class="order-time">桌号 {{item.table_no}} · {{item.formattedTime}}</text>
        </view>
        <text class="order-status status-{{item.status}}">{{item.statusLabel}}</text>
      </view>

      <!-- Items summary -->
      <view class="order-items">
        <text class="items-text">{{item.itemsSummary}}</text>
      </view>

      <!-- Footer -->
      <view class="order-footer">
        <text class="order-total">合计 <text class="total-amount">¥{{item.totalStr}}</text></text>
        <view class="order-actions">
          <view wx:if="{{item.status === 'pending_payment'}}"
            class="action-btn btn-amber"
            bindtap="onPayOrder"
            data-id="{{item.id}}"
            data-total="{{item.total}}">
            去付款
          </view>
        </view>
      </view>
    </view>
  </view>

</view>
