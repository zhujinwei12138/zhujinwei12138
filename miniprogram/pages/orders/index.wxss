/* pages/orders/index.wxss */
.page {
  min-height: 100vh;
  background: #f9fafb;
}

.loading-center {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
  color: #9ca3af;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.tab-active .tab-text {
  color: #d97706;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #f59e0b;
  border-radius: 2rpx;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #9ca3af; margin-bottom: 32rpx; }

.go-order-btn {
  background: #f59e0b;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* Order list */
.order-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  padding: 28rpx;
}

.order-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-meta { flex: 1; min-width: 0; }

.order-id {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  display: block;
}

.order-time {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 4rpx;
}

/* Status badges */
.order-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-pending_payment { background: #fef3c7; color: #d97706; }
.status-paid { background: #dbeafe; color: #2563eb; }
.status-preparing { background: #ede9fe; color: #7c3aed; }
.status-completed { background: #dcfce7; color: #16a34a; }
.status-cancelled { background: #f3f4f6; color: #6b7280; }
.status-refunded { background: #f3f4f6; color: #6b7280; }

.order-items {
  padding: 16rpx 0;
  border-top: 1rpx solid #f9fafb;
  border-bottom: 1rpx solid #f9fafb;
  margin-bottom: 16rpx;
}

.items-text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-total {
  font-size: 26rpx;
  color: #6b7280;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #d97706;
}

.order-actions { display: flex; gap: 16rpx; }

.action-btn {
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
}

.btn-amber {
  background: #f59e0b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
