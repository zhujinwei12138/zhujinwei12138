<!-- pages/index/index.wxml -->
<view class="page-wrap">

  <!-- Setup Overlay -->
  <view class="setup-overlay" wx:if="{{showSetup}}">
    <view class="setup-card">
      <view class="setup-hero">🍺</view>
      <view class="setup-title">欢迎扫码点单</view>
      <view class="setup-sub">请选择商家并输入桌号</view>

      <view class="setup-form">
        <view class="form-item">
          <text class="form-label">选择商家</text>
          <picker mode="selector" range="{{merchants}}" range-key="name"
            value="{{setupMerchantIdx}}" bindchange="onSetupMerchantChange">
            <view class="picker-row">
              <text class="picker-text">{{merchants[setupMerchantIdx].name || '请选择'}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">桌号</text>
          <input class="form-input" placeholder="例如：A08" value="{{setupTableNo}}"
            bindinput="onSetupTableInput" maxlength="10" />
        </view>

        <button class="btn-amber setup-btn" bindtap="onSetupConfirm"
          disabled="{{!setupTableNo}}">
          确认入座，开始点单
        </button>
      </view>
    </view>
  </view>

  <!-- Header -->
  <view class="header">
    <view class="header-top">
      <view class="header-info">
        <text class="merchant-name">{{merchantName || '请选择商家'}}</text>
        <view class="merchant-status">
          <text class="status-dot">●</text>
          <text class="status-text">营业中</text>
        </view>
      </view>
      <view class="table-badge" bindtap="onChangeSeat">
        <text class="table-label">桌号</text>
        <text class="table-no">{{tableNo || '--'}}</text>
      </view>
    </view>

    <!-- Category tabs -->
    <scroll-view class="cat-scroll" scroll-x enable-flex>
      <view class="cat-list">
        <view wx:for="{{categories}}" wx:key="*this"
          class="cat-item {{selectedCategory === item ? 'cat-active' : ''}}"
          bindtap="onCategoryTap" data-category="{{item}}">
          {{item}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Product Grid -->
  <view class="product-grid-wrap">
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中…</text>
    </view>

    <view wx:elif="{{products.length === 0}}" class="empty-state">
      <text class="empty-icon">🍺</text>
      <text class="empty-text">暂无商品</text>
    </view>

    <view wx:else class="product-grid">
      <view wx:for="{{products}}" wx:key="id" class="product-card"
        bindtap="onProductTap" data-product="{{item}}">

        <!-- Image -->
        <view class="product-img-wrap">
          <image class="product-img" src="{{item.image_url || ''}}"
            mode="aspectFill" lazy-load />
          <view wx:if="{{!item.image_url}}" class="product-img-placeholder">🍺</view>
          <view wx:if="{{item.badge}}" class="product-badge">{{item.badge}}</view>
        </view>

        <!-- Info -->
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.description}}</text>
          <text class="product-volume">{{item.volume}}</text>
        </view>

        <!-- Price + Add -->
        <view class="product-footer" catchtap="stopPropagation">
          <text class="product-price">¥{{item.price}}</text>
          <view class="qty-controls">
            <view wx:if="{{item._qty > 0}}" class="qty-minus"
              catchtap="onReduceFromCart" data-id="{{item.id}}">−</view>
            <text wx:if="{{item._qty > 0}}" class="qty-num">{{item._qty}}</text>
            <view class="qty-plus" catchtap="onAddToCart" data-product="{{item}}">＋</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Bottom padding for cart bar + tab bar -->
  <view style="height: 240rpx;"></view>

  <!-- Floating Cart Bar -->
  <view class="cart-bar" wx:if="{{cartCount > 0}}" bindtap="onCartBarTap">
    <view class="cart-icon-wrap">
      <text class="cart-icon">🛒</text>
      <view class="cart-badge">{{cartCount > 9 ? '9+' : cartCount}}</view>
    </view>
    <view class="cart-info">
      <text class="cart-count-text">已选 {{cartCount}} 件</text>
      <text class="cart-total">¥{{cartTotalStr}}</text>
    </view>
    <view class="cart-checkout-btn">去结算</view>
  </view>

  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-bar-item active">
      <text class="tab-icon">🏠</text>
      <text class="tab-label">首页</text>
    </view>
    <view class="tab-bar-item" bindtap="onTabProfile">
      <text class="tab-icon">👤</text>
      <text class="tab-label">我的</text>
      <view class="tab-badge" wx:if="{{cartCount > 0}}">{{cartCount > 9 ? '9+' : cartCount}}</view>
    </view>
  </view>

</view>
