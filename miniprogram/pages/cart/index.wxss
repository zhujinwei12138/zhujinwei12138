/* pages/cart/index.wxss */
.page {
  min-height: 100vh;
  background: #f9fafb;
  padding: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; color: #9ca3af; }
.empty-sub { font-size: 26rpx; color: #d1d5db; margin-top: 8rpx; }

.go-home-btn {
  margin-top: 40rpx;
  background: #f59e0b;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.total-count { font-size: 26rpx; color: #6b7280; }

.clear-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.clear-icon { font-size: 24rpx; }
.clear-text { font-size: 26rpx; color: #9ca3af; }

.items-list { display: flex; flex-direction: column; gap: 20rpx; }

.cart-item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
}

.item-img-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fffbeb;
  flex-shrink: 0;
}

.item-img { width: 100%; height: 100%; }

.item-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.item-info { flex: 1; min-width: 0; }

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-volume {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 6rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.item-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #d97706;
}

.qty-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.minus {
  border: 2rpx solid #f59e0b;
  color: #f59e0b;
}

.plus {
  background: #f59e0b;
  color: #fff;
}

.qty-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  min-width: 32rpx;
  text-align: center;
}

/* Checkout Footer */
.checkout-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.no-seat-tip {
  font-size: 24rpx;
  color: #ef4444;
  text-align: center;
  margin-bottom: 16rpx;
}

.footer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.footer-label { font-size: 28rpx; color: #6b7280; }

.footer-total {
  font-size: 48rpx;
  font-weight: 800;
  color: #d97706;
}

.checkout-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
}
