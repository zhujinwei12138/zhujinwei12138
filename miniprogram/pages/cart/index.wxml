<!-- pages/cart/index.wxml -->
<view class="page">

  <!-- Empty Cart -->
  <view wx:if="{{cart.length === 0}}" class="empty-state">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车是空的</text>
    <text class="empty-sub">去首页添加想喝的啤酒吧</text>
    <navigator url="/pages/index/index" class="go-home-btn" open-type="reLaunch">
      去首页
    </navigator>
  </view>

  <!-- Cart Items -->
  <view wx:else>
    <!-- Top bar -->
    <view class="top-bar">
      <text class="total-count">共 {{cart.reduce ? '' : ''}}{{cart.length}} 种商品</text>
      <view class="clear-btn" bindtap="onClearCart">
        <text class="clear-icon">🗑</text>
        <text class="clear-text">清空</text>
      </view>
    </view>

    <!-- Items list -->
    <view class="items-list">
      <view wx:for="{{cart}}" wx:key="id" class="cart-item card">
        <view class="item-img-wrap">
          <image wx:if="{{item.image_url}}" class="item-img"
            src="{{item.image_url}}" mode="aspectFill" />
          <view wx:else class="item-img-placeholder">🍺</view>
        </view>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-volume">{{item.volume}}</text>
          <view class="item-bottom">
            <text class="item-price">¥{{item.price}}</text>
            <view class="qty-controls">
              <view class="qty-btn minus" bindtap="onDecrease" data-id="{{item.id}}">−</view>
              <text class="qty-num">{{item.quantity}}</text>
              <view class="qty-btn plus" bindtap="onIncrease" data-id="{{item.id}}">＋</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom padding -->
    <view style="height: 200rpx;"></view>
  </view>

  <!-- Checkout Footer (always visible when cart not empty) -->
  <view class="checkout-footer" wx:if="{{cart.length > 0}}">
    <view wx:if="{{!merchantId || !tableNo}}" class="no-seat-tip">
      ⚠️ 请先在首页选择商家和桌号
    </view>
    <view class="footer-top">
      <text class="footer-label">合计</text>
      <text class="footer-total">¥{{cartTotal.toFixed(2)}}</text>
    </view>
    <button class="btn-amber checkout-btn" bindtap="onSubmitOrder"
      disabled="{{!merchantId || !tableNo || submitting}}">
      {{submitting ? '提交中…' : '提交订单'}}
    </button>
  </view>

</view>
