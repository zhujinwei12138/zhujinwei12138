/* pages/payment/index.wxss */
.page {
  min-height: 100vh;
  background: #f9fafb;
  padding: 32rpx;
}

/* Success screen */
.success-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 40rpx;
}

.success-circle {
  width: 120rpx;
  height: 120rpx;
  background: #dcfce7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #16a34a;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.success-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.success-sub {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 48rpx;
}

.success-btn {
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f59e0b;
  color: #fff;
}

/* Fail screen */
.fail-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.fail-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.fail-title { font-size: 40rpx; font-weight: 700; color: #111827; margin-bottom: 12rpx; }
.fail-sub { font-size: 28rpx; color: #9ca3af; margin-bottom: 48rpx; }

.fail-btn {
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f59e0b;
  color: #fff;
  margin-bottom: 24rpx;
}

.fail-back {
  font-size: 28rpx;
  color: #9ca3af;
  text-decoration: underline;
}

/* Pending screen */
.pending-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 40rpx;
}

.pending-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.pending-title { font-size: 40rpx; font-weight: 700; color: #111827; }
.pending-sub { font-size: 26rpx; color: #9ca3af; margin-top: 8rpx; }

.pending-amount {
  font-size: 64rpx;
  font-weight: 800;
  color: #d97706;
  margin: 32rpx 0;
}

.polling-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fef3c7;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
}

.polling-dot {
  color: #f59e0b;
  font-size: 20rpx;
  animation: blink 1s infinite;
}

.polling-text { font-size: 26rpx; color: #92400e; }

.mock-section {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.mock-tip { font-size: 22rpx; color: #9ca3af; }

.mock-btn {
  width: 80%;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  background: #f59e0b;
  color: #fff;
  border: none;
}

.mock-btn::after { border: none; }

/* Payment form */
.order-summary {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.summary-label { font-size: 28rpx; color: #6b7280; }
.summary-value { font-size: 28rpx; color: #111827; }
.summary-amount { font-size: 44rpx; font-weight: 800; color: #d97706; }

.divider { height: 1rpx; background: #f3f4f6; margin: 8rpx 0; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  margin-bottom: 20rpx;
}

.methods { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 40rpx; }

.method-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}

.method-active { border-color: #f59e0b; background: #fffbeb; }

.method-icon { font-size: 48rpx; }

.method-info { flex: 1; }

.method-name { font-size: 30rpx; font-weight: 600; color: #111827; display: block; }
.method-desc { font-size: 24rpx; color: #9ca3af; display: block; margin-top: 4rpx; }

.method-radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
}

.radio-active {
  border-color: #f59e0b;
  background: #f59e0b;
  position: relative;
}

.radio-active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 50%;
}

.pay-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-bottom: 24rpx;
}

.pay-btn::after { border: none; }

.safe-hint {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  display: block;
}
