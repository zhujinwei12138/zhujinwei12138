<!-- pages/profile/index.wxml -->
<view class="page">

  <!-- Header -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <view class="avatar">
        <text class="avatar-text">{{isLoggedIn ? phone.substring(0,3) + '…' : '👤'}}</text>
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{isLoggedIn ? phone : '未登录'}}</text>
      <text class="user-tag">{{isLoggedIn ? '🍺 精酿达人' : '点击登录享受更多'}}</text>
    </view>
    <view wx:if="{{!isLoggedIn}}" class="login-btn" bindtap="onLoginTap">登录</view>
  </view>

  <!-- Body -->
  <view class="body-content">

    <!-- Order Quick Access -->
    <view class="card section-card">
      <view class="section-top">
        <text class="section-title">我的订单</text>
        <view class="section-more" bindtap="onOrdersTap">
          <text class="more-text">全部订单</text>
          <text class="more-arrow">›</text>
        </view>
      </view>
      <view class="order-icons">
        <view class="order-icon-item" bindtap="onOrdersTap">
          <text class="order-icon">⏳</text>
          <text class="order-icon-label">待付款</text>
        </view>
        <view class="order-icon-item" bindtap="onOrdersTap">
          <text class="order-icon">🍺</text>
          <text class="order-icon-label">备货中</text>
        </view>
        <view class="order-icon-item" bindtap="onOrdersTap">
          <text class="order-icon">✅</text>
          <text class="order-icon-label">已完成</text>
        </view>
        <view class="order-icon-item" bindtap="onOrdersTap">
          <text class="order-icon">↩️</text>
          <text class="order-icon-label">退款/售后</text>
        </view>
      </view>
    </view>

    <!-- Quick links -->
    <view class="card section-card">
      <!-- Cart -->
      <view class="menu-item" bindtap="onCartTap">
        <view class="menu-icon-wrap amber">
          <text class="menu-icon">🛒</text>
        </view>
        <view class="menu-info">
          <text class="menu-title">购物车</text>
          <text class="menu-desc">{{cartCount > 0 ? cartCount + ' 件商品待结算' : '去选购你喜欢的啤酒'}}</text>
        </view>
        <view class="menu-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
        <text class="menu-arrow">›</text>
      </view>

      <!-- About -->
      <view class="menu-item" bindtap="onAbout">
        <view class="menu-icon-wrap blue">
          <text class="menu-icon">ℹ️</text>
        </view>
        <view class="menu-info">
          <text class="menu-title">关于我们</text>
          <text class="menu-desc">精酿啤酒点单系统 v2.0</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- Current session -->
    <view wx:if="{{merchantName}}" class="session-info">
      <text class="session-icon">📍</text>
      <text class="session-text">当前：{{merchantName}} · 桌号 {{tableNo || '--'}}</text>
      <view class="change-btn" bindtap="onChangeSeat">换座</view>
    </view>

    <!-- Logout (only if logged in) -->
    <view wx:if="{{isLoggedIn}}" class="card logout-card" bindtap="onLogout">
      <text class="logout-text">退出登录</text>
    </view>

  </view>

  <!-- OTP Login Modal -->
  <view wx:if="{{showOtpModal}}" class="modal-mask">
    <view class="modal-sheet">
      <view class="modal-header">
        <text class="modal-title">手机号登录</text>
        <view class="modal-close" bindtap="onCloseOtp">✕</view>
      </view>

      <view class="modal-form">
        <input class="modal-input" type="number" placeholder="请输入手机号"
          value="{{otpPhone}}" bindinput="onOtpPhoneInput" maxlength="11" />

        <view class="otp-row">
          <input class="modal-input otp-input" type="number" placeholder="验证码"
            value="{{otpCode}}" bindinput="onOtpCodeInput" maxlength="6" />
          <view class="send-btn {{otpCountdown > 0 ? 'send-disabled' : ''}}"
            bindtap="onSendOtp">
            {{otpCountdown > 0 ? otpCountdown + 's' : (otpSending ? '发送中' : '获取验证码')}}
          </view>
        </view>

        <button class="btn-amber modal-submit" bindtap="onVerifyOtp"
          disabled="{{otpVerifying}}">
          {{otpVerifying ? '验证中…' : '确认登录'}}
        </button>
      </view>
    </view>
  </view>

  <!-- Custom Tab Bar -->
  <view class="tab-bar">
    <view class="tab-bar-item" bindtap="onTabHome">
      <text class="tab-icon">🏠</text>
      <text class="tab-label">首页</text>
    </view>
    <view class="tab-bar-item active">
      <text class="tab-icon">👤</text>
      <text class="tab-label">我的</text>
    </view>
  </view>

</view>
