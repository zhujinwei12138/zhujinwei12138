/* pages/profile/index.wxss */
.page {
  min-height: 100vh;
  background: #f9fafb;
  padding-bottom: calc(108rpx + env(safe-area-inset-bottom));
}

/* Profile header */
.profile-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 48rpx 32rpx 72rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap { flex-shrink: 0; }

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f59e0b;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.user-info { flex: 1; min-width: 0; }

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-tag {
  font-size: 24rpx;
  color: #fcd34d;
  display: block;
  margin-top: 8rpx;
}

.login-btn {
  background: #f59e0b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

/* Body pulls up over header */
.body-content {
  padding: 0 24rpx;
  margin-top: -40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-card { padding: 0; overflow: hidden; }

.section-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.more-text { font-size: 24rpx; color: #9ca3af; }
.more-arrow { font-size: 28rpx; color: #d1d5db; }

/* Order icons row */
.order-icons {
  display: flex;
  padding: 20rpx 0;
}

.order-icon-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.order-icon { font-size: 48rpx; }

.order-icon-label {
  font-size: 22rpx;
  color: #6b7280;
}

/* Menu items */
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.amber { background: #fef3c7; }
.blue { background: #dbeafe; }
.green { background: #dcfce7; }

.menu-icon { font-size: 36rpx; }

.menu-info { flex: 1; min-width: 0; }

.menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  display: block;
}

.menu-desc {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 4rpx;
}

.menu-badge {
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.menu-arrow { font-size: 32rpx; color: #d1d5db; }

/* Session info */
.session-info {
  background: #fef3c7;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.session-icon { font-size: 28rpx; }
.session-text { flex: 1; font-size: 26rpx; color: #92400e; }

.change-btn {
  font-size: 24rpx;
  color: #d97706;
  font-weight: 600;
  flex-shrink: 0;
}

/* Logout */
.logout-card {
  padding: 28rpx;
  text-align: center;
}

.logout-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ef4444;
}

/* OTP Modal */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  background: #fff;
  width: 100%;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  background: #f3f4f6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b7280;
}

.modal-form { display: flex; flex-direction: column; gap: 20rpx; }

.modal-input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #111827;
}

.otp-row { display: flex; gap: 16rpx; }

.otp-input { flex: 1; }

.send-btn {
  flex-shrink: 0;
  background: #fef3c7;
  color: #d97706;
  font-size: 24rpx;
  font-weight: 500;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.send-disabled { opacity: 0.5; }

.modal-submit {
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  width: 100%;
  background: #f59e0b;
  color: #fff;
}

.modal-submit::after { border: none; }
