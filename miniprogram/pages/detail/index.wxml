<!-- pages/detail/index.wxml -->
<view class="page">
  <view wx:if="{{loading}}" class="loading-center">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{product}}">
    <!-- Product Image -->
    <view class="img-wrap">
      <image wx:if="{{product.image_url}}" class="product-img"
        src="{{product.image_url}}" mode="aspectFill" />
      <view wx:else class="img-placeholder">🍺</view>
      <view wx:if="{{product.badge}}" class="badge">{{product.badge}}</view>
    </view>

    <!-- Info -->
    <view class="info-card">
      <view class="info-top">
        <view class="info-left">
          <text class="name">{{product.name}}</text>
          <text class="volume">{{product.volume}}</text>
        </view>
        <text class="price">¥{{product.price}}</text>
      </view>

      <view wx:if="{{product.alcohol}}" class="alcohol-tag">
        🍶 酒精度 {{product.alcohol}}
      </view>

      <view class="divider"></view>

      <text class="section-title">商品介绍</text>
      <text class="desc">{{product.description || '暂无介绍'}}</text>

      <view class="divider"></view>

      <!-- Quantity + Cart -->
      <view class="action-row">
        <view class="qty-row">
          <view class="qty-btn minus" bindtap="onReduce"
            style="opacity: {{qty > 0 ? 1 : 0.3}}">−</view>
          <text class="qty-val">{{qty}}</text>
          <view class="qty-btn plus" bindtap="onAdd">＋</view>
        </view>

        <button class="btn-amber add-btn" bindtap="onAdd">
          加入购物车
        </button>
      </view>
    </view>
  </block>

  <!-- Cart Bar at bottom -->
  <view class="cart-hint" wx:if="{{cartCount > 0}}" bindtap="onCartTap">
    <text class="cart-hint-text">🛒 购物车 {{cartCount}} 件 · ¥{{cartTotal.toFixed(2)}} → 去结算</text>
  </view>
</view>
